#!/usr/bin/env node

const Path = require('node:path')
const { statSync } = require('node:fs')
const { parseArgs } = require('node:util')

const { Shape, Fault, One } = require('shape')

const Pkg = require('../package.json')

const { CreateSdkGen } = require('../dist/create-sdkgen.js') 

// const rootpath = require.resolve('../dist/standard/CreateRoot')

let KONSOLE = global['con'+'sole']

// Print stack traces only when the user actually selected a verbose level.
// Read from argv directly: handleError can fire before options are parsed.
//
// Both spellings must agree. `--debug=warn` carries its value in one token,
// but the space-separated `--debug warn` leaves a BARE `--debug` in argv — so
// matching a bare token turned stacks on for every level, including warn/error,
// while the `=` form correctly did not.
function debugLevel() {
  const argv = process.argv
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i]
    if (a.startsWith('--debug=')) {
      return a.slice('--debug='.length)
    }
    if ('--debug' === a) {
      // Bare flag: the level is the NEXT token, unless another option follows
      // (or nothing does), in which case no level was selected.
      const next = argv[i + 1]
      return (null != next && !next.startsWith('-')) ? next : ''
    }
  }
  return ''
}

const DEBUG_STACK = ['debug', 'trace'].includes(debugLevel())

run()


async function run() {
  try {
    let options = resolveOptions()

    if(options.version) {
      version()
    }

    if(options.help) {
      help()
    }

    if(options.version || options.help) {
      exit()
    }

    options = validateOptions(options)

    // AWAIT: generate() is async. Dropping the promise meant every async
    // failure (a failing `npm install` / `add-target`, a write error) escaped
    // this catch and surfaced as a raw unhandled-rejection crash dump instead
    // of a Voxgig error message with a non-zero exit.
    await generate(options)
  }
  catch(err) {
    handleError(err)
  }
}


function exit(err) {
  let code = 0
  if(err) {
    code = 1
  }
  process.exit(code)
}


async function generate(options) {
  const createSdkGen = CreateSdkGen({
    debug: options.debug
  })


  const spec = {
    root: 'CreateRoot',

    name: options.name,
    def: options.def,
    dryrun: options.dryrun,
    project: options.project,
    folder: options.folder,
    install: options.install,
    target: options.target,
    feature: options.feature,
  }

  // console.log('OPTIONS', options)

  return createSdkGen.generate(spec)
}



function resolveOptions() {

  let args

  try {
    args = parseArgs({
      allowPositionals: true,
      allowNegative: true,
      options: {
        def: {
          type: 'string',
          short: 'd',
          default: ''
        },

        project: {
          type: 'string',
          short: 'p',
          default: 'standard'
        },

        folder: {
          type: 'string',
          short: 'o',
          default: ''
        },

        dryrun: {
          type: 'boolean',
          default: false,
        },

        install: {
          type: 'boolean',
          default: true,
        },

        target: {
          type: 'string',
          short: 't',
          multiple: true
        },

        feature: {
          type: 'string',
          short: 'f',
          multiple: true
        },

        debug: {
          type: 'string',
          default: 'info'
        },
        
        help: {
          type: 'boolean',
          short: 'h',
        },
        
        version: {
          type: 'boolean',
          short: 'v',
        },
        
      }
    })
  }
  catch(err) {
    if('ERR_PARSE_ARGS_UNKNOWN_OPTION' === err.code) {
      handleError(err.message.replace(/\. .+$/,'.'))
    }
    throw err
  }

  // Set fake name if -v or -h used.
  let name = args.positionals[0]
  name = null == name ? '' : name
  name = '' === name && (args.values.help || args.values.version) ? '__none__' : name

  let targets = args.values.target || []
  if( 1 < args.positionals.length ) {
    targets.push(...args.positionals.slice(1))
  }

  let features = args.values.feature || []
  
  const options = {
    name,
    def: args.values.def,
    project: args.values.project,
    folder: args.values.folder,
    dryrun: !!args.values.dryrun,
    install: !!args.values.install,
    target: targets,
    feature: features,
    debug: args.values.debug,
    help: !!args.values.help,
    version: !!args.values.version,
  }

  // console.log('ARGS', args, options)

  if(null == options.folder || '' == options.folder) {
    options.folder = options.name + '-sdk'
  }
  
  return options
}


function validateOptions(rawOptions) {
  const optShape = Shape({
    name: Fault('The first argument must be the project name.', String),
    def: '',
    project: String,
    folder: String,
    dryrun: Boolean,
    install: Boolean,
    target: [String],
    feature: [String],
    debug: String,
    help: Boolean,
    version: Boolean,
  })

  const err = []
  const options = optShape(rawOptions,{err})

  if(err[0]) {
    handleError(err[0].text)
  }

  return options
}


function handleError(err) {
  // The message is the useful part; the stack is noise for a CLI user and
  // used to be printed BEFORE the message (twice, with a bare console.trace()
  // pointing at handleError itself rather than at the failure). Keep the
  // stack behind --debug for the cases where it is actually wanted.
  const msg = (err && err.message) ? err.message : String(err)

  KONSOLE.log('Voxgig Create SDK Error: ' + msg)

  if (DEBUG_STACK && err && err.stack) {
    KONSOLE.log(err.stack)
  }

  exit(err)
}


function version() {
  KONSOLE.log(Pkg.version)
}


function help() {
  let s = `
Create a Voxgig SDK Generator project.

Usage: npm create @voxgig/sdkgen@latest <name> <args> 

  <name> is the name of the SDK project. This is also used to
    create a project folder. If run against an existing folder
    generated files will be overwritten.

  <args> are the command arguments:

    --def        Path to the OpenAPI definition file (optional).
    -d

    --project    Project template (folder or package reference). Default: standard.
    -p

    --folder     Target output folder. Default: ./<name>-sdk.
    -o

    --target     Language targets to add (e.g. ts, py, go, rb). Can be
    -t           specified multiple times; extra positional arguments
                 after <name> are also treated as targets.

    --feature    Features to add. Can be specified multiple times.
    -f

    --install    Run installation scripts. Default: install.
    --no-install

    --dryrun     Perform a dry run, where no files are modified. Default: no-dryrun.

    --debug      Set log level (default: info): trace, error, debug, info, warn, fatal.

    --help       Print this help message.
    -h

    --version    Print version number.
    -v


Examples:

# Basic usage
> npm create @voxgig/sdkgen@latest foo
# Creates the SDK Project in the folder ./foo-sdk

See also: https://voxgig.com/sdkgen
`

  KONSOLE.log(s)
}
